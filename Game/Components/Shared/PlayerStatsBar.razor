@using Game.Models

@if (Stats is not null)
{
    <section class="player-stats-bar">
        @foreach (var stat in Stats.AsDictionary())
        {
            var canonical = stat.Value.Canonical.ToLower();
            var iconPath = $"src/Icons/{canonical}.png";
            var cssClass = $"player-stat stat-{canonical}";
            var delta = 0;
            var hasDelta = ShowDeltaFeedback
                && _deltas.TryGetValue(stat.Value.Canonical, out delta);
            var valueClass = hasDelta ? "stat-value-group stat-shake" : "stat-value-group";

            if (hasDelta)
            {
                cssClass += " stat-has-delta";
            }

            <div class="@cssClass"
                 role="group"
                 aria-label="@GetStatAriaLabel(stat.Key, stat.Value.Value, hasDelta ? delta : null)">
                <div class="@valueClass">
                    <div class="shine" />
                    <img src="@iconPath" class="stat-icon" alt="" aria-hidden="true" />
                    <span class="value">@stat.Value.Value</span>
                </div>

                @if (hasDelta)
                {
                    <span @key="GetDeltaFeedbackKey(stat.Value.Canonical)"
                          class="stat-delta @GetDeltaClass(delta)"
                          aria-hidden="true">
                        @FormatDelta(delta)
                    </span>
                }

                <div class="tooltip tooltip-top" aria-hidden="true">
                    @stat.Key
                </div>
            </div>
        }
    </section>
}

@code {
    [Parameter]
    public Stats? Stats { get; set; }

    [Parameter]
    public bool ShowDeltaFeedback { get; set; } = true;

    private Dictionary<string, int> _previousValues = new();
    private Dictionary<string, int> _deltas = new();
    private const int DeltaDisplayDurationMilliseconds = 5200;
    private int _deltaVersion;

    protected override void OnParametersSet()
    {
        if (Stats is null) return;

        var current = Stats.AsDictionary()
            .ToDictionary(s => s.Value.Canonical, s => s.Value.Value);

        if (!ShowDeltaFeedback)
        {
            _previousValues = current;
            _deltas.Clear();
            _deltaVersion++;
            return;
        }

        if (_previousValues.Count == 0)
        {
            _previousValues = current;
            return;
        }

        var changedDeltas = new Dictionary<string, int>();
        foreach (var (key, value) in current)
        {
            if (_previousValues.TryGetValue(key, out var prev))
            {
                if (prev != value)
                {
                    changedDeltas[key] = value - prev;
                }
            }
        }

        _previousValues = current;

        if (changedDeltas.Count > 0)
        {
            _deltas = changedDeltas;
            var version = ++_deltaVersion;
            _ = ClearDeltasAfterDelay(version);
        }
    }

    private static string FormatDelta(int delta)
        => delta > 0 ? $"+{delta}" : delta.ToString();

    private static string GetDeltaClass(int delta)
        => delta > 0 ? "stat-change-increase" : "stat-change-decrease";

    private string GetDeltaFeedbackKey(string canonical)
        => $"{canonical}-delta-{_deltaVersion}";

    private static string GetStatAriaLabel(string label, int value, int? delta)
    {
        if (delta is null)
        {
            return $"{label}: {value}.";
        }

        var direction = delta > 0 ? "növekedett" : "csökkent";
        return $"{label}: {value}, {direction} {Math.Abs(delta.Value)}.";
    }

    private async Task ClearDeltasAfterDelay(int version)
    {
        await Task.Delay(DeltaDisplayDurationMilliseconds);

        if (version != _deltaVersion)
        {
            return;
        }

        _deltas.Clear();
        await InvokeAsync(StateHasChanged);
    }
}
