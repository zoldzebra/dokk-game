                <button class="fancy-light" onclick="location.href='/competence-areas'">
                    <div class="shine" />
                    Lássuk a fejlődési területeket!
                </button>
            </div>
        </div>
    </section>


    <img class="home-background" alt="Hallway" src="src/Backgrounds/hallway.JPG"/>
</div>
